BOT_TOKEN=123456:ABC...
# Adminlarning Telegram ID raqamlari (vergul bilan)
ADMIN_IDS=111111111,222222222
# Railway'da Volume /data ga ulanadi
DATA_DIR=/data
MAX_JOBS=3
# Eng uzun video (daqiqa)
MAX_VIDEO_MIN=30
# Ixtiyoriy: Instagram/YouTube uchun cookies
# COOKIES_FILE=/data/cookies.txt
# --- yangi (ixtiyoriy) ---
# BACKUP_HOURS=24      # baza zaxirasi egalarga necha soatda yuboriladi (0 = o'chirilgan)
# WARM_HOURS=6         # mashhur qo'shiqlar necha soatda tayyorlanadi (0 = o'chirilgan)
# WARM_TOP=10          # bir safarda nechta so'rov tayyorlanadi
# CACHE_CHAT_ID=       # shaxsiy kanal ID (yoki botda /warmchat orqali ulang)
# ALERT_FAILS=10       # 10 daqiqada shuncha xato bo'lsa adminga xabar
# TRANSLIT=1           # qidiruvda lotin<->kirill
